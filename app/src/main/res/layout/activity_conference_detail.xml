<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include
        android:id="@+id/toolbarGradient"
        layout="@layout/toolbar_gradient"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarGradient"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutDirection="rtl"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عنوان همایش"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textAlignment="center"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvDetailOrganizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ارائه دهنده:..............."
                android:textSize="16sp"
                android:textColor="@color/text"
                android:textAlignment="center"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvDetailSummaryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="خلاصه مطالب:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textAlignment="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDetailSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="14sp"
                android:textColor="@color/text"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvDetailAddressLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="آدرس محل برگزاری:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/vazirmatn_bold"
                android:textAlignment="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="14sp"
                android:textColor="@color/text"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تاریخ برگزاری: —"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:fontFamily="@font/vazirmatn_medium"
                android:textAlignment="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ساعت: —"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:fontFamily="@font/vazirmatn_medium"
                android:textAlignment="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvDetailCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ظرفیت باقی مانده: —"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:fontFamily="@font/vazirmatn_medium"
                android:textAlignment="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvDetailNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCollaboration"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:text="علاقه مند به همکاری"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="20dp"
                android:textFontWeight="500"
                android:visibility="gone"
                app:backgroundTint="@color/gray"
                app:cornerRadius="16dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAction"
                android:layout_width="170dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:textAlignment="center"
                android:text="ثبت نام در همایش"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textFontWeight="500"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSupport"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:src="@drawable/support"
        app:backgroundTint="@color/card_background"
        app:tint="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        android:layout_margin="@dimen/margin_medium"
        app:maxImageSize="28dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/card_background"
        style="@style/Widget.Myjava.BottomNavigationView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/text"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="28dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
