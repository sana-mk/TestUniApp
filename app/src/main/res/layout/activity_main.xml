<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:id="@+id/imageView_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/shariaty" />

            <TextView
                android:id="@+id/textView_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="لطفاً وارد حساب کاربری خود شوید!"
                android:textColor="@color/text"
                android:textFontWeight="500"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textView_national_code_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="end"
                android:text="کد ملی:"
                android:textColor="@color/text"
                android:textSize="16sp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_background">

                <EditText
                    android:id="@+id/editText_national_code"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card_background"
                    android:textColor="@color/text_dark"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="14dp"
                    android:paddingStart="14dp"
                    android:inputType="number"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView_password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="end"
                android:text="رمز:"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                />



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_background">

                <EditText
                    android:id="@+id/editText_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card_background"
                    android:textColor="@color/text_dark"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="14dp"
                    android:paddingStart="14dp"
                    android:inputType="textPassword"/>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/layout_captcha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageView_captcha"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:contentDescription="Captcha"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:layout_marginEnd="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background">

                    <EditText
                        android:id="@+id/editText_captcha"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/card_background"
                        android:textColor="@color/text_dark"
                        android:gravity="end|center_vertical"
                        android:paddingEnd="14dp"
                        android:paddingStart="90dp"
                        android:inputType="text"
                        android:hint="کد امنیتی"
                         android:textColorHint="@color/text"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_login"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="ورود"
                android:textSize="16sp"
                android:textColor="@color/background"
                android:textFontWeight="500"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>