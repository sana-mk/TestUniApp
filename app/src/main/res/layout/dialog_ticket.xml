<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ارسال تیکت همکاری"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:fontFamily="@font/vazirmatn_bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="پیام خود را برای مدیر گروه بنویسید"
        android:textSize="12sp"
        android:textColor="@color/text"
        android:fontFamily="@font/vazirmatn_regular"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_background"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/etTicketMessage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:gravity="top|end"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text"
            android:hint="متن پیام خود را اینجا بنویسید..."
            android:fontFamily="@font/vazirmatn_regular"
            android:textSize="13sp"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            android:textAlignment="textStart" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layoutDirection="rtl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendTicket"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="ارسال"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/vazirmatn_bold"
            app:backgroundTint="@color/primary_dark"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelTicket"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="انصراف"
            android:textSize="15sp"
            android:textColor="@color/text_dark"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/vazirmatn_medium"
            app:backgroundTint="@color/card_background"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>
