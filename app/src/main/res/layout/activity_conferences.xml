<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingVertical="@dimen/padding_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBack"
                android:layout_width="@dimen/back_box_width"
                android:layout_height="@dimen/back_box_height"
                android:layout_marginEnd="@dimen/margin_small"
                app:cardCornerRadius="@dimen/back_box_radius"
                app:cardBackgroundColor="@color/primary"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/logout"
                    app:tint="@color/white"
                    android:padding="@dimen/padding_small"
                    android:scaleType="centerInside" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="250dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="@dimen/margin_small"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layoutDirection="rtl"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/managesearch"
                        app:tint="@color/text_dark"/>

                    <EditText
                        android:id="@+id/Searches"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:background="@android:color/transparent"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_dark"
                        android:layoutDirection="rtl"
                        android:textDirection="rtl"
                        android:textAlignment="textStart"
                        android:gravity="start|center_vertical"
                        android:inputType="text"
                        android:singleLine="true"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:cursorVisible="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/menu"
                app:tint="@color/white"
                android:padding="@dimen/padding_small"
                android:layout_marginEnd="@dimen/margin_small" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/title_background"
        android:paddingHorizontal="@dimen/padding_large"
        android:paddingVertical="@dimen/padding_small"
        android:text="@string/conferences_title"
        android:textColor="@color/background"
        android:textSize="20sp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConferences"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingVertical="@dimen/padding_small"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSupport"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:src="@drawable/support"
        app:backgroundTint="@color/card_background"
        app:tint="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        android:layout_margin="@dimen/margin_medium"
        app:maxImageSize="28dp"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/card_background"
        style="@style/Widget.Myjava.BottomNavigationView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/text"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="28dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
